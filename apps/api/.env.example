# PostgreSQL bağlantısı (docker-compose.yml ile aynı bilgiler)
DATABASE_URL="postgresql://gorev:gorev_dev@localhost:5434/gorev_takip?schema=public"
# Üretimde mutlaka uzun ve rastgele bir değer verin: openssl rand -hex 32
JWT_SECRET="degistir-beni-uzun-rastgele-bir-deger"
PORT=4000
# Web uygulamasının adresi (CORS için)
WEB_ORIGIN="http://localhost:3000"
# "Bugün", "gecikti" hesapları için saat dilimi
APP_TZ="Europe/Istanbul"
